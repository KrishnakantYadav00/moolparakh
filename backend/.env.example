# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:krishna@localhost:5432/fproject2026"

# JWT Auth (single-buyer login)
JWT_SECRET=moolparakh-dev-secret-change-in-prod
BUYER_EMAIL=admin@moolparakh.in
BUYER_PASSWORD=MoolParakh@2026

# Gemini AI (optional — enables LLM spec parsing & GDELT classification)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare R2 (optional — enables document upload; leave blank to disable)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moolparakh-docs
R2_PUBLIC_URL=           # e.g. https://pub-xxxx.r2.dev  (only if bucket has public access)

# Server
PORT=5000
NODE_ENV=development

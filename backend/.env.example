# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fproject2026"

# Cloudflare R2 (fill in when you create an R2 bucket — leave blank to disable uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moolparakh-docs
R2_PUBLIC_URL=           # e.g. https://pub-xxxx.r2.dev  (only if bucket has public access)

# Server
PORT=5000
NODE_ENV=development

# Frontend (set this in testincrement4/frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api
